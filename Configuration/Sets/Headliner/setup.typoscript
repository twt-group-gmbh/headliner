# Overrides the header partial of fluid_styled_content (higher key = later = wins over the core paths)
lib.contentElement.partialRootPaths.200 = EXT:headliner/Resources/Private/Partials

# Site setting "headliner.subheader.enabled": use the fields subheader_tag and subheader_layout
lib.contentElement.settings.headliner.subheaderFields = {$headliner.subheader.enabled}
