#!/bin/bash
## Description: Run static analysis, the coding-style check and the XLIFF lint (PHPStan + CS-Fixer dry-run + xlf-lint)
## Usage: lint
## Example: "ddev lint"

set -e
cd /var/www/html

echo "=== PHPStan ==="
.Build/bin/phpstan analyse -c Build/phpstan/phpstan.neon

echo "=== PHP-CS-Fixer (dry-run) ==="
.Build/bin/php-cs-fixer fix --config .php-cs-fixer.dist.php --dry-run --diff

echo "=== XLIFF files ==="
php Build/Scripts/xlf-lint.php
