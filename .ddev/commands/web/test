#!/bin/bash
## Description: Run the test suites (unit | functional | js | all)
## Usage: test [unit|functional|js|all]
## Example: "ddev test", "ddev test unit", "ddev test functional", "ddev test js"

set -e
cd /var/www/html

SUITE="${1:-all}"
PHPUNIT=".Build/bin/phpunit"

run_unit() {
    echo "=== Unit tests ==="
    "${PHPUNIT}" -c Build/phpunit/UnitTests.xml
}
run_functional() {
    echo "=== Functional tests ==="
    # Booting TYPO3 can exceed the default CLI memory_limit. DB creds come from
    # .ddev/.env.web; ImageMagick lives at /usr/bin/ in the web container.
    php -d memory_limit=1G "${PHPUNIT}" -c Build/phpunit/FunctionalTests.xml
}

run_js() {
    echo "=== JavaScript tests (Vitest) ==="
    [ -d node_modules/vitest ] || npm ci --no-audit --no-fund
    npm run test:js
}

case "${SUITE}" in
    unit) run_unit ;;
    functional|func) run_functional ;;
    js) run_js ;;
    all) run_unit; run_functional; run_js ;;
    *) echo "Unknown suite '${SUITE}' (expected: unit | functional | js | all)"; exit 1 ;;
esac
