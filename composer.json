{
    "name": "twtgroup/headliner",
    "type": "typo3-cms-extension",
    "description": "",
    "keywords": [
        "TYPO3",
        "extension"
    ],
    "authors": [
        {
            "name": "twtgroup",
            "role": "Developer"
        }
    ],
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.3",
        "typo3/cms-core": "^14.3"
    },
    "require-dev": {
        "typo3/testing-framework": "^8.2 || ^9.0",
        "typo3/cms-install": "^14.3",
        "typo3/cms-setup": "^14.3",
        "typo3/cms-lowlevel": "^14.3",
        "helhum/typo3-console": "^9.0",
        "phpunit/phpunit": "^12.5",
        "friendsofphp/php-cs-fixer": "^3.51",
        "phpstan/phpstan": "^2.1",
        "saschaegerer/phpstan-typo3": "^3.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Twtgroup\\Headliner\\": "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Twtgroup\\Headliner\\Tests\\": "Tests"
        }
    },
    "replace": {
        "typo3-ter/headliner": "self.version"
    },
    "config": {
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin",
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "TYPO3\\TestingFramework\\Composer\\ExtensionTestEnvironment::prepare"
        ]
    },
    "extra": {
        "typo3/cms": {
            "web-dir": ".Build/public",
            "extension-key": "headliner",
            "version": "1.0.0",
            "Package": {
                "providesPackages": {}
            }
        }
    }
}
